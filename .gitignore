nimcache/
nimrod
# Build output (bin/nimrod, debug builds).
/bin/
*.swp
.env
nimble.develop
nimble.paths
nimbledeps

# Compiled test binaries.  Nim writes an extensionless executable next to
# each tests/<name>.nim, so ignore extensionless files under tests/ while
# keeping every source (*.nim) and the tests/data/ vectors.
#
# This replaces a hand-maintained per-file list that had drifted: 46 test
# binaries (215 MB) were tracked, so any full test run left the tree dirty
# and tripped promote_mainnet.sh's DIRTY-TREE gate.
tests/*
!tests/*.*
!tests/*/

# Phase B verifyscript shim ELF. Source is tools/phaseb_verifyscript_shim.nim;
# rebuild with `nimble build_shim` or
#   nim c -d:release -o:tools/phaseb_verifyscript_shim tools/phaseb_verifyscript_shim.nim
# Previously tracked; every rebuild rewrote ELF bytes (GNU BuildID among
# them) and left the tree dirty (DIRTY-TREE skip).
/tools/phaseb_verifyscript_shim

src/mempool/cluster
src/rpc/rest

# Storage test artifacts
src/storage/chainstate
src/storage/db

.claude/skills/

anchors.dat
banlist.json
.claude/

# Audit notes are kept outside this repository.
audit/
CORE-PARITY-AUDIT/

# Local node state and logs from running in the repository root.
*.log
peers.dat
mempool.dat
fee_estimates.json
nimrod.pid

