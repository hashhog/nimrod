nimcache/
nimrod
*.swp
.env
nimble.develop
nimble.paths
nimbledeps

# Compiled test binaries.  Nim writes an extensionless executable next to
# each tests/<name>.nim, so ignore extensionless files under tests/ while
# keeping every source (*.nim) and the tests/data/ vectors.
#
# This replaces a hand-maintained per-file list that had drifted: 46 test
# binaries (215 MB) were tracked, so any full test run left the tree dirty
# and tripped promote_mainnet.sh's DIRTY-TREE gate.
tests/*
!tests/*.*
!tests/*/

src/mempool/cluster
src/rpc/rest

# Storage test artifacts
src/storage/chainstate
src/storage/db

.claude/skills/

anchors.dat
banlist.json
.claude/

# Project-meta audit artifacts live in the meta-repo (audit-archive/).
audit/
CORE-PARITY-AUDIT/
